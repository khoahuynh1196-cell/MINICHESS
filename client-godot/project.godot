; Engine configuration file.
; This project renders authoritative combat events and never simulates combat rules.
config_version=5

[application]

config/name="Auto Battler 2D Alpha"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/icons/app-icon-v1.png"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"

[display/window/handheld]

orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

[rendering/textures/vram_compression]

import_etc2_astc=true
